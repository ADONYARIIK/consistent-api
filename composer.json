    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Adonyarik\\ConsistentApi\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Yaroslav Tyrchenko",
            "email": "tyrchenkoy@gmail.com"
        }
    ],
    "require": {
